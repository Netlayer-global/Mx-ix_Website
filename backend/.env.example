# ═══════════════════════════════════════════════════════════════════════════════
# MX-IX Admin Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ──
PORT=5000
NODE_ENV=development

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017/mx-ix-admin

# ── JWT ──
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ── Admin Default Credentials (initial seed only) ──
ADMIN_EMAIL=admin@mx-ix.com
ADMIN_PASSWORD=admin123

# ── Frontend URL (CORS) ──
FRONTEND_URL=http://localhost:5173

# ── Grafana + Zabbix (traffic monitoring) ──
GRAFANA_URL=http://103.139.191.165:3000
GRAFANA_API_KEY=
GRAFANA_ZABBIX_UID=bezy0nzf8ykg0c
ZABBIX_URL=
ZABBIX_API_TOKEN=

# ── Alice-LG Looking Glass ──
LG_API_URL=http://103.139.191.168/api/v1
ALICE_CONFIG_PATH=
ALICE_RELOAD_CMD=

# ── SMTP (email notifications) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MX-IX Status <status@mx-ix.com>

# ══════════════════════════════════════════════════════════════════════════════
# IXP FABRIC — Native peering infrastructure
# ══════════════════════════════════════════════════════════════════════════════

# ── IRRDB (as-set expansion via bgpq4) ──
# These are HOST-LEVEL settings (they reach a command line) and must NOT be
# made admin-editable through the web UI.
BGPQ4_PATH=bgpq4
IRRDB_SOURCES=RIPE,APNIC,AFRINIC,LACNIC,ARIN,RADB,NTTCOM
IRRDB_HOST=
IRRDB_TIMEOUT_MS=180000
IRRDB_RECURSION_LIMIT=
IRRDB_STALE_MINUTES=1440

# ── PeeringDB OAuth (member portal "Sign in with PeeringDB") ──
PEERINGDB_OAUTH_CLIENT_ID=
PEERINGDB_OAUTH_CLIENT_SECRET=
PEERINGDB_OAUTH_REDIRECT_URI=

# ── Mailman 3 (mailing list subscribe/unsubscribe) ──
MAILMAN_API_URL=
MAILMAN_API_USER=restadmin
MAILMAN_API_PASSWORD=
MAILMAN_LISTS=peering@lists.mx-ix.net

# ══════════════════════════════════════════════════════════════════════════════
# NOTE: The following are configured via the admin panel Settings page
# (stored in the database, not env vars):
#   - IXP Manager API URL + key
#   - PeeringDB API base URL + key (for sync, not OAuth)
#   - Zoho Books credentials
#   - Flow graph (sFlow/Akvorado) embed URL template
#   - Contact form recipients
# ══════════════════════════════════════════════════════════════════════════════
